{
  "name": "fpo-setu-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@op-engineering/op-sqlite": "^17.1.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@dbkable/react-native-speech-to-text": "^1.0.0",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "react-native start",
    "android": "node scripts/ensure-metro.js && react-native run-android --no-packager",
    "stop": "node scripts/stop-metro.js",
    "typecheck": "tsc --noEmit",
    "apk": "cd android && gradlew.bat assembleRelease",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "lint": "eslint ."
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.fposetu.mobile"
    }
  },
  "private": true
}
